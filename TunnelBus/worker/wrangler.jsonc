{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tunnel-bus",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Host routing + Access: see ../README.md. Empty = path routing only / Access off.
  "vars": {
    "ACCESS_REQUIRED": "true",
    "ACCESS_TEAM_DOMAIN": "laxid.cloudflareaccess.com",
    "ACCESS_AUD": "430edc5c0631389af5d4b8af4f32c92386e189afdfd60d1247813a92bf0be553",
    "BUS_BASE_DOMAIN": "ref12.dev",
    "BUS_CONTROL_HOST": "ctl.ref12.dev",
    "BUS_LABEL_SUFFIX": "",
    "BUS_ADMIN_EMAILS": "lancec@microsoft.com"
  },
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "TunnelBusContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BUS", "class_name": "TunnelBusContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TunnelBusContainer"] }]
}
