{
  "manifest_version": 3,
  "name": "poe-bots bridge",
  "version": "0.1.0",
  "description": "Lets the local poe-bots CLI run Poe's own GraphQL calls inside your signed-in poe.com session. Talks only to the native host com.ref12.poebots.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://poe.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://poe.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}